# Copy this file to ".env" (same folder as main.py) and fill in the key. NEVER commit .env or share the key.
GEMINI_API_KEY=your-key-here
# The model used by the agent. Tested: gemini-3.5-flash-lite. Run `python check_models.py` to see which models answer today.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- optional settings (defaults in brackets) ----
# GEMINI_DEADLINE_S=40          seconds to wait for one Gemini answer
# GEMINI_ATTEMPTS=3             tries before giving up on Gemini
# GEMINI_WAIT_S=4               pause between tries (grows with each try)
# KB_DIR=knowledge_base         folder with the knowledge-base articles (.md or .txt)
# KB_MAX_DISTANCE=              ignore search results farther than this (off by default)
# KB_EMBED_MODE=full            "full" = embed the whole article, "summary" = title + keywords + symptoms
# MEMORY_DB=data/agent_memory.db   where long-term memory is stored
# SHOW_THOUGHTS=1               1 = show the agent's reasoning ([THOUGHT] lines), 0 = off
# THINKING_LEVEL=medium         how much Gemini thinks before acting (measured: low returned a readable summary 1 time in 3, medium and high 3 in 3)
# EVAL_SHOW_THOUGHTS=0          set to 1 to run the evaluation with thoughts on (off by default)
